#!/usr/bin/env node

import * as streamconsumers from "node:stream/consumers";
import fs from "node:fs/promises";
import process from "node:process";
import util from "node:util";
import * as TextWrap from "./library/TextWrap.js";

import Anthropic from "./library/Anthropic.js";
import Gemini from "./library/Gemini.js";
import OpenAI from "./library/OpenAI.js";

import Edit from "./library/Edit.js";
import Execute from "./library/Execute.js";

let providers = [
  {
    runner: OpenAI,
    prefix: "gpt-",
    baseURL: "https://api.openai.com/",
    apiKey: process.env.OPENAI_API_KEY
  },
  {
    runner: Gemini,
    prefix: "gemini-",
    baseURL: "https://generativelanguage.googleapis.com/",
    apiKey: process.env.GEMINI_API_KEY
  },
  {
    runner: Anthropic,
    prefix: "claude-",
    baseURL: "https://api.anthropic.com/",
    apiKey: process.env.ANTHROPIC_API_KEY
  }
];

let tools = { edit: Edit, execute: Execute };

function print(message, options = {}) {
  console.log(TextWrap.wrap(message, {
    width: process.stdout.columns ?? 80,
    margin: 2,
    ...options
  }));
}

function printModelMessage(text) {
  console.log();
  print(text, {
    marker: "⏵",
    prefixPatterns: [ "#+\\s+", "\\s*[*\\-]\\s+", "\\s*\\d+\\.\\s+" ]
  });
  console.log();
}

async function callTool(name, args) {
  let result;

  try {
    let cls = tools[name];
    if (cls === undefined)
      throw new Error(`Unknown tool: ${name}`);

    let tool = new cls(args);
    print(tool.toString(), { marker: tool.symbol });
    result = await tool.call();
  } catch (error) {
    print(`Error calling ${name} tool: ${error}`, { marker: "✘" });
    result = typeof error.toJSON === "function" ? error : { error: String(error) };
  }

  return result;
}

function modelRunner(model, baseURL) {
  let provider = providers.find(p => model.startsWith(p.prefix));
  if (provider === undefined)
    throw new Error(`Unknown model name: ${model}`);

  baseURL = new URL(baseURL ?? provider.baseURL);
  if (!baseURL.pathname.endsWith("/"))
    baseURL.pathname += "/";

  return provider.runner({
    apiKey: provider.apiKey,
    model,
    tools: Object.values(tools).map(t => t.schema),
    callTool,
    message: printModelMessage,
    baseURL
  });
}

function readFiles(paths) {
  return Promise.all(paths.map(path => fs.readFile(path, "utf8")));
}

async function main() {
  let { values: options, positionals } = util.parseArgs({
    options: {
      model: { type: "string", default: "gpt-5.2-codex" },
      system: { type: "string", multiple: true },
      file: { type: "string", multiple: true },
      "system-file": { type: "string", multiple: true },
      "base-url": { type: "string" }
    },
    allowPositionals: true
  });

  let run = modelRunner(options.model, options["base-url"]);
  let prompt = {
    system: [],
    user: positionals
  };

  if (options.system !== undefined)
    prompt.system.push(options.system);

  if (options["system-file"] !== undefined)
    prompt.system.push(...await readFiles(options["system-file"]));

  if (options.file !== undefined)
    prompt.user.push(...await readFiles(options.file));

  if (!process.stdin.isTTY)
    prompt.user.push(await streamconsumers.text(process.stdin));

  let { tokens } = await run(prompt);
  console.log(`■ ${tokens} tokens`);
}

try {
  await main();
} catch (error) {
  console.error(TextWrap.wrap(String(error.stack), {
    width: process.stdout.columns ?? 80,
    margin: 2,
    marker: "✘"
  }));
}
