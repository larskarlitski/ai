#!/usr/bin/env node

import * as Git from "./library/Git.js";
import * as Log from "./library/Log.js";
import * as streamconsumers from "node:stream/consumers";
import Agent from "./library/Agent.js";
import fs from "node:fs/promises";
import os from "node:os";
import process from "node:process";
import util from "node:util";

const help = `ai [OPTIONS] PROMPT...

A minimal, non-interactive coding agent. Runs a single agent loop: passes all
prompts and optionally stdin to the model, gives it sandboxed access to the
current directory, and lets it run commands and edit files until it considers
itself to be done. The model receives no further human input.

Options:
  --transcript FILE   Save detailed transcript to FILE
  --model NAME        Model to use (default: gpt-5.2-codex)
  --system PROMPT     System prompt to pass to the model (can be repeated)
  --file FILE         Read an additional prompt from FILE (can be repeated)
  --system-file FILE  Read a system prompt from FILE (can be repeated)
  --base-url URL      Override the provider's API base URL
  --workspace TYPE    Create a writable workspace for the agent. Type must be "git".
                      Changes are pulled back into a branch.

  If stdin is not a terminal, its contents are appended to the user prompt.
`;

async function workspaceDirectory() {
  let state = process.env.XDG_STATE_HOME;
  if (state === undefined)
    state = `${os.homedir()}/.local/state`;

  let workspaces = `${state}/ai/workspaces`;
  await fs.mkdir(workspaces, { recursive: true });

  return workspaces;
}

function readFiles(paths) {
  return Promise.all(paths.map(path => fs.readFile(path, "utf8")));
}

async function main() {
  let { values: options, positionals } = util.parseArgs({
    options: {
      help: { type: "boolean" },
      transcript: { type: "string" },
      model: { type: "string", default: "gpt-5.2-codex" },
      system: { type: "string", multiple: true },
      file: { type: "string", multiple: true },
      "system-file": { type: "string", multiple: true },
      "base-url": { type: "string" },
      "workspace": { type: "string" }
    },
    allowPositionals: true
  });

  if (options.help === true) {
    console.log(help);
    return;
  }

  await Log.setup(options.transcript);

  let agent = new Agent(options.model, {
    baseURL: options["base-url"]
  });

  let prompt = {
    system: [],
    user: positionals
  };

  if (options.system !== undefined)
    prompt.system.push(...options.system);

  if (options["system-file"] !== undefined)
    prompt.system.push(...await readFiles(options["system-file"]));

  if (options.file !== undefined)
    prompt.user.push(...await readFiles(options.file));

  if (!process.stdin.isTTY)
    prompt.user.push(await streamconsumers.text(process.stdin));

  let workspace;
  if (options.workspace === "git") {
    let repository = await Git.topLevel(process.cwd());
    workspace = await Git.setupWorkspace(repository, await workspaceDirectory());
  }

  try {
    let { tokens } = await agent.run(prompt, workspace);

    let message = `${tokens} tokens`;
    if (options.transcript)
      message += `; transcript saved to ${options.transcript}`;
    Log.info("■", message);
  } finally {
    if (workspace !== undefined)
      await Git.teardownWorkspace(workspace, { pushChanges: true });

    await Log.close();
  }
}

await main();
