#!/usr/bin/env node

import * as streamconsumers from "node:stream/consumers";
import process from "node:process";
import util from "node:util";

import Anthropic from "./library/Anthropic.js";
import Gemini from "./library/Gemini.js";
import OpenAI from "./library/OpenAI.js";

import * as Execute from "./library/Execute.js";

let providers = [
  {
    runner: OpenAI,
    prefix: "gpt-",
    apiKey: process.env.OPENAI_API_KEY
  },
  {
    runner: Gemini,
    prefix: "gemini-",
    apiKey: process.env.GEMINI_API_KEY
  },
  {
    runner: Anthropic,
    prefix: "claude-",
    apiKey: process.env.ANTHROPIC_API_KEY
  }
];

let tools = { execute: Execute };

async function callTool(name, args) {
  let tool = tools[name];
  if (tool === undefined)
    throw new Error(`Tool not found: ${name}`);

  console.log(`${name.toUpperCase()} ${tool.argsToString(args)}`);

  try {
    return await tool.call(args);
  } catch (error) {
    return { error: error.message };
  }
}

function message(message, options = {}) {
  if (options.type !== undefined) {
    console.log(`${options.type.toUpperCase()} ${message}`);
  } else {
    console.log();
    console.log(message);
    console.log();
  }
}

function modelRunner(model) {
  let provider = providers.find(p => model.startsWith(p.prefix));
  if (provider === undefined)
    throw new Error(`Unknown model name: ${model}`);

  return provider.runner({
      apiKey: provider.apiKey,
      model,
      tools: Object.values(tools).map(t => t.schema),
      callTool,
      message
  });
}

async function main() {
  let { values: options, positionals } = util.parseArgs({
    options: {
      model: { type: "string", default: "gpt-5.2-codex" },
      system: { type: "string", multiple: true },
      verbose: { type: "boolean" }
    },
    allowPositionals: true
  });

  let run = modelRunner(options.model);
  let prompt = {};

  if (options.system !== undefined)
    prompt.system = options.system;

  prompt.user = positionals;

  if (!process.stdin.isTTY)
    prompt.user.push(await streamconsumers.text(process.stdin));

  let r = await run(prompt, tools, message);
  console.log(`DONE ${r.tokens} tokens`);
}

try {
  await main(process.argv.slice(2));
} catch (error) {
  console.error(options.verbose ? error.stack : error);
}
